# Dev-only overrides. Never put real Alpaca credentials or activation
# secrets here — those live encrypted in SQLite (see ARCHITECTURE.md, §6-8).

# Base URL of the monstra.pro API this device talks to for activation,
# strategy pulls, and software updates.
MONSTRA_PRO_BASE_URL=https://monstra.pro

# Where device_core stores its SQLite file and other local state during
# local development (defaults to a platform data dir when unset).
MONSTRAPRO_DATA_DIR=./.data

# Log level for all services in local dev.
MONSTRAPRO_LOG_LEVEL=INFO
