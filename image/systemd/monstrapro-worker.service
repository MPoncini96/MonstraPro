[Unit]
Description=Monstra.Pro Box trading worker
# No Requisite=monstrapro-firstboot.service - see monstrapro-display.service's
# comment for why that breaks on every boot after the first (firstboot's
# ConditionPathExists guard means it's skipped, not "active", once its
# marker file exists). After= alone is correct here.
After=network-online.target monstrapro-firstboot.service monstrapro-lcd-setup.service
Wants=network-online.target

[Service]
Type=simple
User=monstrapro
Group=monstrapro
WorkingDirectory=/opt/monstrapro/current
ExecStart=/opt/monstrapro/current/services/trading_worker/.venv/bin/python -m trading_worker.main
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/monstrapro/env
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
