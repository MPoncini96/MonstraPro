[Unit]
Description=Monstra.Pro Box status display
# Deliberately does NOT wait on network-online.target or any Wi-Fi/agent
# unit - Objectives.txt requires the display to start immediately while
# networking and other services initialize. monstrapro-firstboot.service
# only does local filesystem/ownership setup, so it adds effectively no
# delay - see image/README.md "First-boot state flow". Ordered (not
# required) after monstrapro-lcd-setup.service so a steady-state boot
# renders straight to the already-configured LCD; if LCD setup ever fails,
# display still starts rather than being blocked by a display-config nicety.
#
# No Requisite=monstrapro-firstboot.service here (deliberately removed) -
# firstboot's ConditionPathExists guard means it's *skipped*, not
# "active", on every boot after the first. Requisite= requires the target
# to be genuinely active, so it would silently block this unit from ever
# starting again after the first boot - After= alone (ordering only, not
# an activeness requirement) is the correct dependency. Caught live on
# real Pi 5 hardware: `systemctl status` showed enabled+inactive with zero
# log entries, i.e. never even attempted to start.
After=local-fs.target monstrapro-firstboot.service monstrapro-lcd-setup.service

[Service]
Type=simple
User=monstrapro
Group=monstrapro
WorkingDirectory=/opt/monstrapro/current
ExecStart=/opt/monstrapro/current/services/display/.venv/bin/python -m display.main
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/monstrapro/env
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
